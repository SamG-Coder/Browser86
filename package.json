{
  "name": "browser86",
  "version": "0.1.0",
  "private": true,
  "description": "An original browser-hosted x86 interpreter, PE loader and small Win32 compatibility runtime. No Wine.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "start": "node tools/serve.mjs",
    "test": "node --test tests/*.test.mjs",
    "demos": "python tools/build-demos.py",
    "test:managed": "node --test tests/managed*.test.mjs",
    "demos:managed": "node tools/build-managed-demo.mjs"
  },
  "engines": {
    "node": ">=22"
  }
}
